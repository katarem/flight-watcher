# Copia a .env. Son las credenciales del administrador inicial (solo se usan al crear
# la cuenta la primera vez; luego se gestiona todo desde el panel). Si dejas la contraseña
# vacía se genera una aleatoria y se escribe en el log del primer arranque.
# Versión de la imagen de ghcr.io que usa el compose (latest, 1.1.0, 1.1…).
FW_VERSION=latest

PANEL_USER=admin
PANEL_PASSWORD=cambia-esto
# 1 si sirves el panel por HTTPS (la cookie de sesión solo viajará cifrada).
COOKIE_SECURE=
# 0 bloquea el código de los proveedores desde el panel: siguen funcionando, pero no se pueden crear,
# importar, cambiar su código ni probar.
PROVIDER_SCRIPTS=1
