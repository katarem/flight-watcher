#flight-watcher:proveedores v1 separador=%%fw%%
# 5 proveedores exportados el 2026-10-12 desde flight-watcher 1.8.1.
# Cada bloque: una línea con el separador y los datos en JSON, y debajo el script de Python tal cual.
%%fw%% {"key": "vueling", "label": "Vueling", "color": "#e8a800", "coverage": "probe", "max_routes": null, "health_origin": "SVQ", "health_destination": "TFN", "link_template": "https://tickets.vueling.com/booking?o={origin}&d={destination}&dd={date}&adt=1&chd=0&inf=0&c=es-ES&cur=EUR", "notes": "Calendario de ~1 año en una petición. Verificado contra la web real el 2026-09-30. Bloquea las IP de centros de datos: ejecutar desde una IP residencial. Residentes en islas/Ceuta: añade &dt=1 a la plantilla de enlace.", "min_interval": 1.5, "stealth": 0}
"""Vueling.

Precios: API JSON pública que usa la propia web para pintar el calendario (`apiw.vueling.com/api/v1/availability`).
Devuelve el precio más bajo de cada día de ~1 año en una sola petición y no necesita navegador. Verificado el
2026-09-30: responde también a un cliente que no es navegador; 404 = Vueling no opera esa ruta.

Cobertura «probe»: se pregunta a esa misma API por cada ruta; un 404 significa que Vueling no la opera.
"""

API_URL = "https://apiw.vueling.com/api/v1/availability"


def availability(api, origin, destination):
    return api.get_json(API_URL, originCode=origin, destinationCode=destination,
                        providerName="DmpsRetrieveAvailabilityProvider", currencyCode="EUR",
                        lowPriceClassificationPercentage=25)


def probe(api, origin, destination):
    return availability(api, origin, destination) is not None


def fetch_route(api, origin, destination, start, max_months):
    data = availability(api, origin, destination)
    if data is None:  # 404: no opera la ruta
        return {}
    end = add_months(start, max_months)
    out = {}
    for row in (data.get("availability") or {}).get("value") or []:
        if row.get("isInvalidPrice") or not row.get("price"):
            continue
        day = date.fromisoformat(row["departureDate"][:10])
        if start <= day < end:
            out[day] = min(float(row["price"]), out.get(day, math.inf))
    return out
%%fw%% {"key": "ryanair", "label": "Ryanair", "color": "#073590", "coverage": "network", "max_routes": null, "health_origin": "SVQ", "health_destination": "BCN", "link_template": "https://www.ryanair.com/es/es/trip/flights/select?adults=1&teens=0&children=0&infants=0&dateOut={date}&isReturn=false&originIata={origin}&destinationIata={destination}", "notes": "Tarifas por mes de la API del calendario y red de rutas del buscador de la web. Solo vuelos directos. Precios verificados el 2026-09-30 (la red de rutas, sin verificar).", "min_interval": 1.5, "stealth": 0}
"""Ryanair.

Precios: API JSON pública de tarifas (`/api/farfnd/v4/oneWayFares/.../cheapestPerDay`), la misma que pinta el
calendario de ryanair.com. Una petición por mes, sin navegador. Verificado el 2026-09-30. No entiende códigos de
ciudad (TCI): el checker ya los expande a aeropuertos.

Cobertura «network»: la red de rutas que usa el buscador de la web
(`/api/views/locate/searchWidget/routes/es/airport/{origen}`): los destinos directos desde un aeropuerto.

Si la ruta no existe, la API de tarifas devuelve todos los días sin precio: se trata como «sin precios», no como
error de la web. La ruta SVQ↔TFS es estacional (en invierno no hay precios).
"""

API_URL = "https://www.ryanair.com/api/farfnd/v4/oneWayFares/{origin}/{destination}/cheapestPerDay"
ROUTES_URL = "https://www.ryanair.com/api/views/locate/searchWidget/routes/es/airport/{origin}"


def network(api, origin):
    data = api.get_json(ROUTES_URL.format(origin=origin))
    if data is None:  # 404: el aeropuerto no está en su red
        return []
    if not isinstance(data, list):
        raise ProviderError("Ryanair: la red de rutas tiene un formato inesperado (¿ha cambiado?)")
    return {(r.get("arrivalAirport") or {}).get("code") for r in data
            if isinstance(r, dict) and not r.get("connectingAirport")} - {None}


def fetch_route(api, origin, destination, start, max_months):
    out = {}
    url = API_URL.format(origin=origin, destination=destination)
    for i in range(max_months):
        month = add_months(start, i)
        data = api.get_json(url, outboundMonthOfDate=month.isoformat(), currency="EUR")
        if data is None:
            break
        for fare in (data.get("outbound") or {}).get("fares") or []:
            price = fare.get("price") or {}
            value = price.get("value")
            if not value or fare.get("unavailable") or fare.get("soldOut"):
                continue
            day = date.fromisoformat(fare["day"])
            if day >= start and (day not in out or float(value) < out[day].price):
                out[day] = DayPrice(day, float(value), currency=(price.get("currencyCode") or "EUR").upper())
    return out
%%fw%% {"key": "wizzair", "label": "Wizz Air", "color": "#c6007e", "coverage": "network", "max_routes": null, "health_origin": "BCN", "health_destination": "BUD", "link_template": "https://wizzair.com/es-es/booking/select-flight/{origin}/{destination}/{date}/null/1/0/0/null", "notes": "Sin verificar contra la web real. Mapa de rutas y calendario por mes de la API de la web. Precios en la moneda de salida (se pasan a euros).", "min_interval": 1.5, "stealth": 0}
"""Wizz Air (sin verificar contra la web real: pruébalo desde la IP donde corre el panel).

Sin navegador, con las APIs JSON que usa wizzair.com:

- Versión de la API: `https://wizzair.com/buildnumber` devuelve «SSR https://be.wizzair.com/X.Y.Z».
- Cobertura «network»: `{api}/Api/asset/map?languageCode=es-es` lista las ciudades con sus conexiones.
- Precios: `POST {api}/Api/search/timetable` con un tramo de fechas (un mes por petición). Devuelve el precio
  más bajo por día en la moneda del aeropuerto de salida (HUF, PLN, EUR…): el panel lo pasa a euros.

Wizz Air es conocido por cortar a los clientes que no son un navegador (403/429): si pasa, la prueba lo muestra
como «bloqueado».
"""
import threading
import time

BUILD_URL = "https://wizzair.com/buildnumber"
API_RE = re.compile(r"https://be\.wizzair\.com/[\d.]+")

# Caché del script (vive mientras el proveedor esté cargado): versión de la API (6 h) y mapa de rutas (1 h).
_lock = threading.Lock()
_cache = {}


def cached(name, max_age, load):
    with _lock:
        hit = _cache.get(name)
        if hit and time.monotonic() - hit[0] < max_age:
            return hit[1]
    value = load()
    with _lock:
        _cache[name] = (time.monotonic(), value)
    return value


def api_base(api):
    def load():
        r = api.request("GET", BUILD_URL, headers={"Accept": "text/plain, */*"})
        m = API_RE.search(r.text if r is not None else "")
        if not m:
            raise ProviderError("Wizz Air: no encuentro la versión de su API en /buildnumber (¿ha cambiado?)")
        return m[0]
    return cached("api", 6 * 3600, load)


def routes_map(api):
    def load():
        data = api.get_json(f"{api_base(api)}/Api/asset/map", languageCode="es-es")
        if not isinstance(data, dict) or not isinstance(data.get("cities"), list):
            raise ProviderError("Wizz Air: el mapa de rutas tiene un formato inesperado (¿ha cambiado?)")
        return {c["iata"]: {x.get("iata") for x in c.get("connections") or []} - {None}
                for c in data["cities"] if isinstance(c, dict) and c.get("iata")}
    return cached("map", 3600, load)


def network(api, origin):
    return routes_map(api).get(origin, set())


def fetch_route(api, origin, destination, start, max_months):
    base = api_base(api)
    out = {}
    for i in range(max_months):
        lo = max(start, add_months(start, i))
        hi = add_months(start, i + 1) - timedelta(days=1)
        body = {
            "flightList": [{"departureStation": origin, "arrivalStation": destination,
                            "from": lo.isoformat(), "to": hi.isoformat()}],
            "priceType": "regular", "adultCount": 1, "childCount": 0, "infantCount": 0,
        }
        data = api.post_json(f"{base}/Api/search/timetable", body)
        if data is None:
            break
        for f in data.get("outboundFlights") or []:
            price = f.get("price") or {}
            amount = price.get("amount")
            if f.get("priceType") != "price" or not amount:
                continue
            day = date.fromisoformat(str(f.get("departureDate", ""))[:10])
            if day >= start and (day not in out or float(amount) < out[day].price):
                out[day] = DayPrice(day, float(amount), currency=(price.get("currencyCode") or "EUR").upper())
    return out
%%fw%% {"key": "google", "label": "Google Flights", "color": "#1a73e8", "coverage": "universal", "max_routes": 12, "health_origin": "SVQ", "health_destination": "TFN", "link_template": "https://www.google.com/travel/flights?hl=es&gl=ES&curr=EUR&q=Vuelos%20de%20{origin}%20a%20{destination}%20el%20{date}%20solo%20ida", "notes": "Sin verificar contra Google. Busca en todas las aerolíneas (también con escalas). API interna del calendario, sin documentar; como mucho 12 pares de aeropuertos por vigilancia.", "min_interval": 3.0, "stealth": 0}
"""Google Flights (sin verificar contra Google: pruébalo desde la IP donde corre el panel).

Cobertura «universal»: busca cualquier ruta (directa o con escalas) entre todas las aerolíneas, así que no hay red
que consultar; lo que limita es el número de pares por vigilancia.

Precios: la llamada interna `GetCalendarGraph` que pinta el calendario de precios de google.com/travel/flights
(el precio más bajo de cada día de un tramo de fechas), sin navegador. Es una API sin documentar: si cambia el
formato, la ronda falla con un error claro en lugar de guardar datos malos. Como `fetch_route` acepta
`max_stops`, recibe el filtro de escalas de la vigilancia.
"""

API_URL = ("https://www.google.com/_/FlightsFrontendUi/data/travel.frontend.flights.FlightsFrontendService/"
           "GetCalendarGraph")
ISO = re.compile(r"^\d{4}-\d{2}-\d{2}$")
#: Días por petición (el calendario de Google no admite tramos muy largos).
WINDOW_DAYS = 60
#: Escalas de la vigilancia → filtro de Google (0 = cualquiera, 1 = directo, 2 = ≤ 1 escala, 3 = ≤ 2).
STOPS = {None: 0, 0: 1, 1: 2, 2: 3}


def request_body(origin, destination, start, end, max_stops):
    """`f.req` de un viaje de solo ida, 1 adulto, turista, entre dos aeropuertos."""
    segment = [[[[origin, 0]]], [[[destination, 0]]], None, STOPS.get(max_stops, 0), None, None,
               start.isoformat(), None, None, None, None, None, None, None, 3]
    query = [None, [None, None, 2, None, [], 1, [1, 0, 0, 0], None, None, None, None, None, None, [segment],
                    None, None, None, 1], [start.isoformat(), end.isoformat()]]
    return json.dumps([None, json.dumps(query, separators=(",", ":"))], separators=(",", ":"))


def first_price(node):
    """Primer `[null, número]` dentro de un nodo (así viene el precio de cada día)."""
    if isinstance(node, list):
        if len(node) >= 2 and node[0] is None and isinstance(node[1], (int, float)) and not isinstance(node[1], bool):
            return float(node[1])
        for item in node:
            p = first_price(item)
            if p is not None:
                return p
    return None


def walk(node, out):
    if not isinstance(node, list):
        return
    if node and isinstance(node[0], str) and ISO.match(node[0]):
        p = first_price(node[1:])
        if p is not None and 1 <= p <= 20000:
            d = date.fromisoformat(node[0])
            out[d] = min(p, out.get(d, p))
            return
    for item in node:
        walk(item, out)


def parse_response(text):
    """Precios por día de la respuesta (`)]}'` + trozos JSON con [["wrb.fr", …, "<json>"]])."""
    out = {}
    found = False
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("["):
            continue
        try:
            chunk = json.loads(line)
        except ValueError:
            continue
        for item in chunk if isinstance(chunk, list) else []:
            if isinstance(item, list) and len(item) > 2 and item[0] == "wrb.fr" and isinstance(item[2], str):
                found = True
                try:
                    walk(json.loads(item[2]), out)
                except ValueError:
                    continue
    if not found:
        raise ProviderError("Google Flights: respuesta con un formato inesperado (¿ha cambiado la API?)")
    return out


def fetch_route(api, origin, destination, start, max_months, max_stops=None):
    end = start + timedelta(days=max_months * 30)
    out = {}
    lo = start
    while lo < end:
        hi = min(end, lo + timedelta(days=WINDOW_DAYS - 1))
        r = api.request(
            "POST", API_URL, params={"hl": "es", "gl": "ES", "curr": "EUR", "rt": "c"},
            data={"f.req": request_body(origin, destination, lo, hi, max_stops)},
            headers={"Content-Type": "application/x-www-form-urlencoded;charset=UTF-8", "Accept": "*/*"},
        )
        if r is None:
            raise ProviderError("Google Flights: la API del calendario ya no existe (HTTP 404)")
        for d, p in parse_response(r.text).items():
            if lo <= d <= hi:
                # El calendario no dice cuántas escalas tiene el más barato, solo que cumple el filtro.
                out[d] = DayPrice(d, p, currency="EUR", stops=0 if max_stops == 0 else None)
        lo = hi + timedelta(days=1)
    return out
%%fw%% {"key": "aireuropa", "label": "Air Europa", "color": "#2d69e1", "coverage": "probe", "max_routes": null, "health_origin": "SVQ", "health_destination": "MAD", "link_template": "https://www.aireuropa.com/es/es/home", "notes": "Sin verificar desde el servidor (2026-10-12): API de Amadeus (api-des.aireuropa.com) vista en la web real. Calendario de 31 días por petición, escalas incluidas; solo sabe filtrar «solo directos». Rellena CLIENT_ID y CLIENT_SECRET en el script (su cabecera dice de dónde salen). Necesita «Siempre Chrome».", "min_interval": 2.0, "stealth": 2}
"""Air Europa (sin verificar contra la API real desde el servidor: pruébalo desde la IP donde corre el panel).

El buscador de aireuropa.com manda al motor de reservas de Amadeus (digital.aireuropa.com), que pide los precios a
la API de Amadeus Digital Experience Suite (DES) en api-des.aireuropa.com. Visto en la web real el 2026-10-12:

- Token anónimo: `POST /v1/security/oauth2/token/initialization` (formulario con client_id, client_secret,
  grant_type=client_credentials y `fact`: la búsqueda y el país en {"keyValuePairs": […]}). Dura 30 min.
- Precios: `GET /v2/search/air-calendars` con origen, destino, una fecha central y `flexibility` (días a cada lado,
  máximo 15: 31 días por petición). Devuelve el precio total más barato de cada día, con escalas incluidas (Air
  Europa casi siempre vuela vía Madrid). `directFlights=true` deja solo los directos.
- Cobertura «probe»: el mismo calendario en dos tramos de fechas; si alguno trae precios, opera la ruta.

Anti-bot: api-des.aireuropa.com está detrás de Imperva, que exige en cada petición un `x-d-token` que solo genera
su JavaScript en las páginas de digital.aireuropa.com (engancha fetch() y lo añade). Desde el servidor, el token sale
con la huella de Chrome, pero el calendario da 403. Por eso el proveedor va con «Medidas anti-bot: Siempre Chrome» y
`BROWSER_PAGE` (abajo): Chrome abre el motor de reservas y las peticiones salen desde ahí, como las de la web. Su
CORS no admite cookies, así que van sin ellas (lo hace solo `BrowserFetch`).

CLIENT_ID y CLIENT_SECRET (vacíos en el catálogo: rellénalos en el editor) son las credenciales del cliente web de
Air Europa, las mismas para cualquier visitante. Para sacarlas: busca un vuelo en aireuropa.com y, en la página de
resultados (digital.aireuropa.com), en la consola de Chrome (Cmd+Opt+I):

    JSON.parse(document.body.dataset.bootstrapconfig)   // gatewayClientId y gatewayClientSecret

Si dejan de valer («no da token»), cópialas otra vez de ahí.
"""
import threading
import time

API = "https://api-des.aireuropa.com"
TOKEN_URL = f"{API}/v1/security/oauth2/token/initialization"
#: Página del motor de reservas que abre Chrome: ahí corre el script de Imperva y su origen es el que admite la API.
#: La final: /booking?lang=es parece cargada antes de que su JavaScript lleve aquí, aún sin el script de Imperva.
BROWSER_PAGE = "https://digital.aireuropa.com/booking/recovery"
CALENDAR_URL = f"{API}/v2/search/air-calendars"
CLIENT_ID = ""
CLIENT_SECRET = ""
#: Lo que pide la web para la tarifa más barata en turista («Lite»/«NOBAG»).
FARE_FAMILY = "DIGITAL1"
#: Días a cada lado de la fecha central (15 es el máximo que acepta: 31 días por petición).
FLEX = 15
WINDOW = 2 * FLEX + 1
#: Respuesta de Amadeus cuando no hay vuelos en esos días.
NO_FLIGHTS = {"7959"}
HEADERS = {"Accept": "application/json"}

#: Sin `fact` la web usa este otro (lo probamos si el de arriba falla).
TOKEN_PLAIN_URL = f"{API}/v1/security/oauth2/token"

# Un token por ruta (el de la web lleva la búsqueda en su `fact`) mientras el proveedor esté cargado.
_lock = threading.Lock()
_tokens = {}


def fact(origin, destination, day):
    """Lo que manda la web al pedir el token: la búsqueda y los datos del portal (España, sin millas)."""
    pairs = [{"key": "originLocationCode1", "value": origin}, {"key": "destinationLocationCode1", "value": destination},
             {"key": "departureDateTime1", "value": day.isoformat()},
             {"key": "CountryPortal", "value": "ES"}, {"key": "useMiles", "value": "false"}]
    return json.dumps({"keyValuePairs": pairs}, separators=(",", ":"))


def token(api, origin, destination, day):
    key = (origin, destination)
    with _lock:
        hit = _tokens.get(key)
        if hit and time.monotonic() < hit[1]:
            return hit[0]
    if not CLIENT_ID or not CLIENT_SECRET:
        raise ProviderError("Air Europa: rellena CLIENT_ID y CLIENT_SECRET en el script (ver su cabecera)")
    form = {"grant_type": "client_credentials", "client_id": CLIENT_ID, "client_secret": CLIENT_SECRET}
    try:
        r = api.request("POST", TOKEN_URL, headers=HEADERS, data={**form, "fact": fact(origin, destination, day)})
    except ProviderBlocked:
        raise
    except ProviderError as exc:
        api.log("token con fact rechazado (", exc, "); pruebo sin fact")
        r = api.request("POST", TOKEN_PLAIN_URL, headers=HEADERS, data=form)
    data = r.json() if r is not None else {}
    value = data.get("access_token")
    if not value:
        raise ProviderError(f"Air Europa: no da token ({str(data)[:200]}); ¿han cambiado las credenciales?")
    api.log("token nuevo para", f"{origin}→{destination}", "· caduca en", data.get("expires_in"), "s")
    with _lock:
        # Se renueva un minuto antes de que caduque.
        _tokens[key] = (value, time.monotonic() + max(60, int(data.get("expires_in") or 1799) - 60))
    return value


def calendar(api, origin, destination, center, direct):
    """{fecha: precio en euros} de los 31 días alrededor de `center`."""
    params = {"originLocationCode": origin, "destinationLocationCode": destination,
              "departureDateTime": center.isoformat(), "commercialFareFamilies": FARE_FAMILY,
              "travelers": "1ADT", "flexibility": FLEX}
    if direct:
        params["directFlights"] = "true"
    auth = {"Authorization": f"Bearer {token(api, origin, destination, center)}"}
    r = api.request("GET", CALENDAR_URL, params=params, headers={**HEADERS, **auth})
    if r is None:
        raise ProviderError("Air Europa: la API del calendario ya no existe (HTTP 404)")
    data = r.json()
    errors = data.get("errors") or []
    if errors and not data.get("data"):
        if all(str(e.get("code")) in NO_FLIGHTS for e in errors):
            return {}
        e = errors[0]
        raise ProviderError(f"Air Europa: {e.get('title') or e.get('code')} {e.get('detail') or ''}".strip())
    currencies = (data.get("dictionaries") or {}).get("currency") or {}
    out = {}
    for day in data.get("data") or []:
        total = ((day.get("prices") or {}).get("totalPrices") or [{}])[0]
        amount, currency = total.get("total"), (total.get("currencyCode") or "EUR").upper()
        if not amount:
            continue
        # Los importes vienen en la unidad mínima de la moneda (céntimos): 5887 = 58,87 €.
        decimals = (currencies.get(currency) or {}).get("decimalPlaces", 2)
        out[date.fromisoformat(day["departureDate"][:10])] = (float(amount) / 10 ** decimals, currency)
    return out


def probe(api, origin, destination):
    today = date.today()
    return any(calendar(api, origin, destination, today + timedelta(days=d), False) for d in (FLEX + 1, 120))


def fetch_route(api, origin, destination, start, max_months, max_stops=None):
    end = add_months(start, max_months)
    direct = max_stops == 0
    out = {}
    lo = start
    while lo < end:
        try:
            found = calendar(api, origin, destination, lo + timedelta(days=FLEX), direct)
        except ProviderBlocked:
            raise
        except ProviderError as exc:
            if not out:
                raise
            # Más allá de lo que vende (unos 11 meses) puede responder con error: se queda lo que ya hay.
            api.log("corto en", lo.isoformat(), "→", exc)
            break
        for d, (price, currency) in found.items():
            if start <= d < end:
                # El calendario no dice cuántas escalas tiene el más barato: solo sabe filtrar «directos» (0).
                # Con max_stops=1 o más no se puede filtrar: None (el checker lo da por bueno).
                out[d] = DayPrice(d, price, currency=currency, stops=0 if direct else None)
        lo += timedelta(days=WINDOW)
    return out
